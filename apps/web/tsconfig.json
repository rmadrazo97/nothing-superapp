{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@nothing/shared": ["../../packages/shared/src"],
      "@nothing/shared/*": ["../../packages/shared/src/*"],
      "@nothing/mini-apps-runtime": ["../../packages/mini-apps-runtime/src"],
      "@nothing/mini-apps-runtime/*": ["../../packages/mini-apps-runtime/src/*"],
      "@nothing-mini-apps/calorie-lite/manifest": ["../mini-apps/calorie-lite/manifest.ts"],
      "@nothing-mini-apps/calorie-lite/page": ["../mini-apps/calorie-lite/page.tsx"],
      "@nothing-mini-apps/calorie-lite/settings": ["../mini-apps/calorie-lite/settings.tsx"],
      "@nothing-mini-apps/coming-soon/manifest": ["../mini-apps/coming-soon/manifest.ts"],
      "@nothing-mini-apps/coming-soon/page": ["../mini-apps/coming-soon/page.tsx"],
      "@nothing-mini-apps/gym-routine/manifest": ["../mini-apps/gym-routine/manifest.ts"],
      "@nothing-mini-apps/gym-routine/page": ["../mini-apps/gym-routine/page.tsx"],
      "@nothing-mini-apps/gym-routine/pages/exercises": ["../mini-apps/gym-routine/pages/exercises.tsx"],
      "@nothing-mini-apps/gym-routine/pages/exercise-detail": ["../mini-apps/gym-routine/pages/exercise-detail.tsx"],
      "@nothing-mini-apps/gym-routine/pages/routines": ["../mini-apps/gym-routine/pages/routines.tsx"],
      "@nothing-mini-apps/gym-routine/pages/routine-editor": ["../mini-apps/gym-routine/pages/routine-editor.tsx"],
      "@nothing-mini-apps/gym-routine/pages/session": ["../mini-apps/gym-routine/pages/session.tsx"],
      "@nothing-mini-apps/gym-routine/pages/history": ["../mini-apps/gym-routine/pages/history.tsx"],
      "@nothing-mini-apps/gym-routine/measurements/page": ["../mini-apps/gym-routine/measurements/page.tsx"],
      "@nothing-mini-apps/gym-routine/progression/page": ["../mini-apps/gym-routine/progression/page.tsx"],
      "@nothing-mini-apps/gym-routine/lib/progression-query": ["../mini-apps/gym-routine/lib/progression-query.ts"],
      "@nothing-mini-apps/habits/manifest": ["../mini-apps/habits/manifest.ts"],
      "@nothing-mini-apps/habits/page": ["../mini-apps/habits/page.tsx"],
      "@nothing-mini-apps/journal/manifest": ["../mini-apps/journal/manifest.ts"],
      "@nothing-mini-apps/journal/page": ["../mini-apps/journal/page.tsx"],
      "@nothing-mini-apps/pomodoro/manifest": ["../mini-apps/pomodoro/manifest.ts"],
      "@nothing-mini-apps/pomodoro/page": ["../mini-apps/pomodoro/page.tsx"],
      "@nothing-mini-apps/reminders/manifest": ["../mini-apps/reminders/manifest.ts"],
      "@nothing-mini-apps/reminders/page": ["../mini-apps/reminders/page.tsx"],
      "@nothing-mini-apps/reminders/settings": ["../mini-apps/reminders/settings.tsx"],
      "@nothing-mini-apps/reminders/resources": ["../mini-apps/reminders/resources.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
