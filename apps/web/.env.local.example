# Nothing Superapp — apps/web/.env.local.example
# Copy to apps/web/.env.local and fill in. NEVER commit apps/web/.env.local.
# Setup guide: README.md#local-dev-setup

# ─── Public (safe to expose to client) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                      # Legacy anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # New-style publishable
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Server-only (never expose to client) ──────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                          # Legacy service_role JWT
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your-database-password

STRIPE_SECRET_KEY=sk_test_...
STRIPE_ACCOUNT_ID=acct_...
STRIPE_PRODUCT_ID=prod_...
STRIPE_PRICE_ID=price_...
# Filled in by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
# Optional — override the model used when a chat turn carries images. If unset,
# KIMI_MODEL is used (kimi-k2.6 already advertises supports_image_in). Force
# e.g. `moonshot-v1-32k-vision-preview` if you want a dedicated vision model.
# KIMI_VISION_MODEL=

# ─── OAuth providers (task 05 wires these up in Supabase Auth UI, not env) ───
# GOOGLE_OAUTH_CLIENT_ID + SECRET go into Supabase dashboard, not here.
# APPLE_TEAM_ID / KEY_ID / P8 go into Supabase dashboard, not here.
